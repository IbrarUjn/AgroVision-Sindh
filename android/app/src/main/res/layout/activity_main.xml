<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_main.xml — Home screen of AgroVision Sindh
  Deep agricultural green gradient theme with glassmorphism card buttons
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    tools:context=".MainActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:titleTextColor="@color/white"
            app:subtitleTextColor="@color/white_70" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="32dp">

            <!-- ── Logo + Title Section ────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="32dp">

                <ImageView
                    android:id="@+id/iv_logo"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_logo"
                    android:contentDescription="AgroVision Sindh Logo" />

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit_bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/subtitle"
                    android:textColor="@color/white_80"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:fontFamily="@font/outfit_regular" />

            </LinearLayout>

            <!-- ── Action Buttons Card ────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_glass"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/white_20"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_instruction"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="@font/outfit_bold" />

                    <!-- Camera Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_camera"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="@string/btn_camera"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/outfit_bold"
                        app:icon="@drawable/ic_camera"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:cornerRadius="16dp"
                        app:backgroundTint="@color/accent_green"
                        android:layout_marginBottom="12dp" />

                    <!-- Gallery Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_gallery"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="@string/btn_gallery"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/outfit_bold"
                        app:icon="@drawable/ic_gallery"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:cornerRadius="16dp"
                        app:backgroundTint="@color/accent_teal"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:strokeColor="@color/accent_teal"
                        app:strokeWidth="2dp"
                        android:layout_marginBottom="12dp" />

                    <!-- AI Assistant Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_chat"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="@string/btn_ask_ai"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/outfit_bold"
                        app:icon="@drawable/ic_assistant"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:cornerRadius="16dp"
                        app:backgroundTint="@color/card_glass"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:strokeColor="@color/accent_lime"
                        app:strokeWidth="1.5dp"
                        android:textColor="@color/accent_lime"
                        app:iconTint="@color/accent_lime" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Supported Crops Info Card ─────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_supported_crops"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/card_glass"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/white_20"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_crops_info"
                        android:contentDescription="Crops info" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/supported_crops_title"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/supported_crops_subtitle"
                            android:textColor="@color/white_70"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_supported_crops"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_view"
                        android:textColor="@color/accent_lime" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Disclaimer Card ────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_disclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/warning_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/warning_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:text="⚠️"
                        android:textSize="18sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/main_disclaimer"
                        android:textColor="@color/warning_text"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Hackathon badge ────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:text="@string/hackathon_badge"
                android:textColor="@color/white_50"
                android:textSize="11sp"
                android:gravity="center" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
